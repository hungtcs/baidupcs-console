# 复制为 .env 后按需修改。所有项都有默认值，可以全部留空。
# 优先级：进程环境变量 > .env > 内置默认值。

# HTTP 监听地址。默认 0.0.0.0:8080，供局域网访问。
# 服务不鉴权，只监听本机时改成 127.0.0.1:8080。
BPCS_LISTEN=0.0.0.0:8080

# BaiduPCS-Go 可执行文件路径，可以是绝对路径或 PATH 里的名字。
BPCS_CLI_PATH=BaiduPCS-Go

# 下载文件的落盘根目录。留空则用 ~/Downloads。
# BPCS_SAVE_ROOT=/data/downloads

# 任务记录的数据目录，一个任务一个 JSON 文件（<data_dir>/tasks/<id>.json）。
# 服务重启后从这里恢复任务列表。相对路径相对于启动时的工作目录。
BPCS_DATA_DIR=data

# 下载模式：locate（默认）/ pcs / stream
BPCS_MODE=locate

# 对应 CLI 的 -p 参数（下载线程数）。0 表示用 CLI 自己的默认值。
BPCS_MAX_THREADS=0

# 每个任务在内存里保留的输出字节上限，超出后丢弃最旧的部分。
BPCS_OUTPUT_BUFFER_BYTES=4194304
